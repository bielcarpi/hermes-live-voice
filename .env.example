# Normal installs use `hermes-live setup`. This file is for containers and
# source development; project .env files are not loaded automatically.

HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_AGENT_API_SERVER_KEY=

# Default: continuous OpenAI voice. Setup prompts for the key when needed.
HERMES_LIVE_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_REALTIME_TURN_DETECTION=disabled  # optional manual turn submission

HERMES_LIVE_HOST=127.0.0.1
HERMES_LIVE_PORT=8788
# Required when the gateway is reachable from another machine.
# HERMES_LIVE_AUTH_TOKEN=
# HERMES_LIVE_ALLOW_ORIGIN=https://your-ui.example

# Optional providers, selected explicitly:
# HERMES_LIVE_PROVIDER=gemini
# GEMINI_API_KEY=
# HERMES_LIVE_PROVIDER=local
# HERMES_LIVE_LOCAL_URL=ws://127.0.0.1:8765/v1/realtime

# Advanced settings and service commands: docs/setup.md.
# `hermes-live print-config` shows resolved values with secrets redacted.
